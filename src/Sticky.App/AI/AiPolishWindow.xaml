<Window x:Class="Sticky.App.AI.AiPolishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 语法修正与润色 · Sticky" Width="860" Height="620" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock x:Name="ActionHeading" Text="AI 文本处理" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ServiceLabel" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="仅发送选中文字和该功能的提示词。检查结果后再替换，也可直接复制结果。" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel><TextBlock Text="选中原文" DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold"/><TextBox x:Name="OriginalBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="#EEF0E9" AutomationProperties.Name="AI 润色原文"/></DockPanel>
      <DockPanel Grid.Column="2"><TextBlock Text="处理结果 · 可以继续修改" DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold"/><TextBox x:Name="ResultBox" IsEnabled="False" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="60000" TextChanged="ResultChanged" AutomationProperties.Name="AI 处理结果"/></DockPanel>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,14"/>
    <Grid Grid.Row="3"><StackPanel Orientation="Horizontal"><Button x:Name="GenerateButton" Content="重新生成" Click="GenerateClicked"/><Button x:Name="ApplyButton" Content="替换原选区" Style="{StaticResource PrimaryButton}" Click="ApplyClicked" IsEnabled="False"/></StackPanel><Button Content="取消" IsCancel="True" HorizontalAlignment="Right" Margin="0"/></Grid>
  </Grid>
</Window>
