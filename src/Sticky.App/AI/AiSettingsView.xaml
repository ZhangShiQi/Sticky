<UserControl x:Class="Sticky.App.AI.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="clr-namespace:Sticky.App.AI">
  <UserControl.Resources><ai:AiIconConverter x:Key="AiIcon"/></UserControl.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="AI 接入与功能" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="连接自己的服务，为选中文字配置常用操作。" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
      <DockPanel><Button Content="载入已保存配置" Click="ReloadClicked" DockPanel.Dock="Right" Padding="10,5" Margin="10,0,0,0"/><TextBlock x:Name="RefreshNotice" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    </StackPanel>
    <TabControl x:Name="AiTabs">
      <TabItem Header="连接与思考">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,12,8,0">
            <TextBlock Text="连接配置" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <ComboBox x:Name="ConnectionBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ConnectionChanged" Margin="0,0,0,12" AutomationProperties.Name="AI 连接配置"/>
            <CheckBox x:Name="EnabledBox" Content="启用 AI 功能" Margin="0,0,0,16"/>
            <TextBlock Text="API 地址" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox x:Name="BaseUrlBox" MaxLength="2048" AutomationProperties.Name="AI API 地址"/>
            <TextBlock Text="OpenAI 兼容的 Base URL（包含 /v1 等路径）或完整 /chat/completions 地址。本机服务支持 HTTP。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,15"/>
            <TextBlock Text="模型名称" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox x:Name="ModelBox" MaxLength="200" AutomationProperties.Name="AI 模型名称"/>
            <TextBlock Text="使用服务商提供的模型 ID。" Foreground="{StaticResource Muted}" Margin="0,6,0,15"/>
            <TextBlock Text="本机 API 密钥" FontWeight="SemiBold" Margin="0,0,0,7"/><PasswordBox x:Name="KeyBox" MaxLength="8192" Padding="10,8" BorderBrush="#DCDDD8" BorderThickness="1" AutomationProperties.Name="AI API 密钥"/>
            <TextBlock x:Name="KeyHint" Foreground="{StaticResource Muted}" Margin="0,6,0,15" TextWrapping="Wrap"/>
            <CheckBox x:Name="ThinkingBox" Content="启用思考模式（默认关闭）" Margin="0,0,0,10" AutomationProperties.Name="AI 思考模式"/>
            <ComboBox x:Name="ThinkingControlBox" SelectedValuePath="Tag" SelectedIndex="0" Margin="0,0,0,7" AutomationProperties.Name="思考模式接口格式">
              <ComboBoxItem Content="自动识别 DeepSeek 官方接口" Tag="auto"/><ComboBoxItem Content="DeepSeek 格式（含自定义代理）" Tag="deepseek"/><ComboBoxItem Content="reasoning_effort 格式" Tag="effort"/><ComboBoxItem Content="不发送参数，由服务商决定" Tag="none"/>
            </ComboBox>
            <TextBlock Text="关闭时向支持的接口显式请求关闭思考。自动识别仅针对 DeepSeek 官方地址；代理或其他服务请选其支持的格式，未识别时不发送参数。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,15"/>
            <TextBlock Text="超时时间（秒，5–180）" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox x:Name="TimeoutBox" Width="100" HorizontalAlignment="Left" Text="60" MaxLength="3"/>
            <WrapPanel Margin="0,18,0,12"><Button x:Name="SaveButton" Content="保存连接" Style="{StaticResource PrimaryButton}" Click="SaveClicked"/><Button x:Name="TestButton" Content="测试连接" Click="TestClicked"/><Button x:Name="CancelTestButton" Content="取消测试" Click="CancelTest" IsEnabled="False"/><Button x:Name="ForgetButton" Content="移除本机密钥" Click="ForgetKey"/></WrapPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
            <TextBlock Text="连接参数、思考开关和自定义功能可随 GitHub 同步。密钥按 Windows 当前用户加密，只留在本机；新设备需填写自己的密钥。移除本机密钥不会关闭其他设备的连接。仅在主动选择 AI 功能时发送选中文字与该功能提示词；连接测试只发送固定示例，服务商可能按请求计费。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="自定义功能">
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DockPanel><Button x:Name="NewActionButton" Content="＋ 新建功能" DockPanel.Dock="Top" Click="NewActionClicked" Margin="0,0,0,10"/>
            <ListBox x:Name="ActionList" SelectionChanged="ActionSelected" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="自定义 AI 功能列表">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4,8"><ContentControl Content="{Binding Icon, Converter={StaticResource AiIcon}}" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" Width="120" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,7,0">
              <TextBlock x:Name="ActionEditorTitle" Text="编辑功能" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="按钮名称" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox x:Name="ActionNameBox" MaxLength="60" AutomationProperties.Name="AI 功能按钮名称"/>
              <TextBlock Text="按钮图标" FontWeight="SemiBold" Margin="0,14,0,7"/>
              <ComboBox x:Name="IconBox" SelectedValuePath="Key" AutomationProperties.Name="AI 功能 SVG 图标">
                <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ContentControl Content="{Binding Key, Converter={StaticResource AiIcon}}" Margin="0,0,10,0"/><TextBlock Text="{Binding Label}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="提示词 / 操作要求" FontWeight="SemiBold" Margin="0,14,0,7"/>
              <TextBox x:Name="PromptBox" MaxLength="8000" MinHeight="170" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="AI 自定义提示词"/>
              <TextBlock Text="例如：翻译成英文，语气专业；或提炼三个要点。选中文字会自动附上，无需占位符。结果先预览，再决定是否替换；这些功能只处理文字，不执行程序或脚本。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,14"/>
              <CheckBox x:Name="ActionEnabledBox" Content="在便签 AI 菜单中显示此功能" IsChecked="True" Margin="0,0,0,16"/>
              <WrapPanel><Button x:Name="SaveActionButton" Content="保存功能" Click="SaveActionClicked" Style="{StaticResource PrimaryButton}"/><Button x:Name="DeleteActionButton" Content="删除功能" Click="DeleteActionClicked"/></WrapPanel>
              <TextBlock x:Name="ActionStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
