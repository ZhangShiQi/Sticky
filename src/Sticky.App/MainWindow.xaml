<Window x:Class="Sticky.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Sticky;component/Assets/Sticky.ico"
        Title="Sticky · 本地便签" Width="1080" Height="740" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="12,11" />
      <Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#EEF0E9" BorderBrush="#E0E3DA" BorderThickness="0,0,1,0">
      <Grid Margin="16,30,16,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="12,0,0,30">
          <Image Source="{StaticResource StickyLogo}" Width="36" Height="36" Margin="-2,-2,8,-2" AutomationProperties.Name="Sticky 图标" />
          <TextBlock Text="Sticky" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="12,0,4,12">
          <TextBlock Text="工作空间" Foreground="#7C8277" FontSize="12" VerticalAlignment="Center" />
          <Button Content="＋" Click="NewGroup" Padding="6,2" Margin="0" HorizontalAlignment="Right" Background="Transparent" ToolTip="新建分组" AutomationProperties.Name="新建分组" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="WorkspaceNavigation">
            <Button x:Name="AllNotesButton" Content="▤   全部便签" Click="ShowNotes" Style="{StaticResource NavigationButton}" Background="{Binding AllBackground}" />
            <ItemsControl x:Name="GroupNavigation" ItemsSource="{Binding GroupItems}"><ItemsControl.ItemTemplate><DataTemplate>
              <Button Click="SelectGroup" Style="{StaticResource NavigationButton}" Background="{Binding Background}" ToolTip="{Binding Group.Name}">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="134" />
                <Button.ContextMenu><ContextMenu><MenuItem Header="重命名分组…" Click="RenameGroup" /></ContextMenu></Button.ContextMenu>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Button x:Name="UngroupedButton" Content="未分组" Click="ShowUngrouped" Style="{StaticResource NavigationButton}" Background="{Binding UngroupedBackground}" />
            <Button x:Name="TrashButton" Content="↺   回收站" Click="ShowTrash" Style="{StaticResource NavigationButton}" Background="{Binding TrashBackground}" />
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,16,0,12">
          <TextBox x:Name="SidebarSearchBox" Height="38" Padding="10,7,26,7" KeyDown="SidebarSearchKeyDown" AutomationProperties.Name="搜索便签" ToolTip="输入关键词，按回车查看搜索结果 · Ctrl+F" />
          <TextBlock Text="搜索便签…" Foreground="#8B9184" Margin="11,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SidebarSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="↵" Foreground="#8B9184" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False" />
        </Grid>
        <Button Grid.Row="4" x:Name="SettingsButton" Content="⚙   设置" Click="OpenSettings" Style="{StaticResource NavigationButton}" Margin="0" Background="Transparent" />
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,30,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid>
        <StackPanel Margin="0,0,170,0">
          <TextBlock Text="{Binding Heading}" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
        </StackPanel>
        <Button Content="＋ 新建便签" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="NewNote" Margin="0,4,0,0" Padding="18,12" ToolTip="Ctrl+N" />
      </Grid>
      <Grid Grid.Row="1" Margin="0,28,0,16">
        <TextBlock Text="{Binding ResultCount}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
        <Button Content="重命名分组…" Click="RenameSelectedGroup" HorizontalAlignment="Right" Background="Transparent" Padding="8,3" Margin="0" Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolVisibility}}" />
      </Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Background="{Binding Background}" CornerRadius="12" Width="300" Height="226" Margin="0,0,16,16" Padding="20,18"
                    MouseLeftButtonDown="CardMouseDown" Cursor="Hand">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="{Binding Preview}" TextWrapping="Wrap" Foreground="#5D5E5A" Margin="0,12,0,12" LineHeight="22" TextTrimming="CharacterEllipsis" />
                <DockPanel Grid.Row="2" Margin="0,0,0,10">
                  <TextBlock Text="{Binding Updated}" FontSize="11" Foreground="#797A70" />
                  <TextBlock Text="{Binding State}" FontSize="11" Foreground="#797A70" HorizontalAlignment="Right" />
                </DockPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                  <Button Content="{Binding Action}" Click="OpenCard" Padding="10,6" Background="#70FFFFFF" FontSize="12" />
                  <Button Content="{Binding GroupName}" Click="MoveCard" Padding="8,6" Background="Transparent" FontSize="12" Foreground="#6B6D65" MaxWidth="85" ToolTip="移动到分组" Visibility="{Binding CanDelete, Converter={StaticResource BoolVisibility}}" />
                  <Button Content="···" Click="CardMenu" Padding="8,6" Background="Transparent" FontSize="12" ToolTip="更多操作" Visibility="{Binding CanDelete, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
        <TextBlock Text="▤" FontSize="48" Foreground="#B1BAAA" HorizontalAlignment="Center" Margin="0,0,0,18" />
        <TextBlock Text="{Binding EmptyTitle}" FontSize="20" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding EmptyDescription}" Foreground="{StaticResource Muted}" Margin="0,10,0,0" />
      </StackPanel>
      <TextBlock Grid.Row="3" Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" />
    </Grid>
  </Grid>
</Window>
