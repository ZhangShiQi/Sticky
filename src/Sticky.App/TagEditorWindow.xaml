<Window x:Class="Sticky.App.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑标签 · Sticky" Width="495" Height="365" MinWidth="340" MinHeight="290" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Closing="SaveOnClose">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="当前便签的标签" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <WrapPanel x:Name="AppliedTags" AutomationProperties.Name="当前便签的标签" />
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#DFE4DC" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,10,0,8">
      <TextBlock Text="可添加的标签" FontSize="15" FontWeight="SemiBold" />
    </Border>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <WrapPanel x:Name="AvailableTags" AutomationProperties.Name="可添加的标签" />
    </ScrollViewer>
    <TextBlock Grid.Row="4" x:Name="TagEditStatus" Text="输入名称筛选，按回车添加。关闭时自动保存。" Foreground="{StaticResource Muted}" Margin="0,7,0,6" TextWrapping="Wrap" />
    <TextBox Grid.Row="5" x:Name="TagFilterBox" TextChanged="FilterChanged" PreviewKeyDown="FilterKeyDown" AutomationProperties.Name="筛选或新建标签" />
  </Grid>
</Window>
