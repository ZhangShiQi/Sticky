<Window x:Class="Sticky.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · Sticky" Width="900" Height="740" MinWidth="780" MinHeight="660" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Padding" Value="16,13" /><Setter Property="MinWidth" Value="130" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="TabLabel" ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="#292B32" TextElement.FontWeight="Normal" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#DDE4D8" /><Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="#2F5346" /><Setter TargetName="TabLabel" Property="TextElement.FontWeight" Value="SemiBold" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Opacity" Value="0.75" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#86917F" /><Setter TargetName="TabSurface" Property="BorderThickness" Value="1" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <TabControl x:Name="SettingsTabs" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="26,0,0,0" Margin="24">
    <TabItem Header="同步">
      <ContentControl x:Name="SyncHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </TabItem>
    <TabItem Header="数据与备份">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
          <TextBlock Text="数据与备份" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="管理本地数据，导入或导出完整便签备份。" Foreground="{StaticResource Muted}" Margin="0,8,0,28" />
          <TextBlock Text="数据目录" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
          <TextBox Text="{Binding DataPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="#EEF0E9" BorderThickness="0" Margin="0,0,0,12" AutomationProperties.Name="数据目录" />
          <Button Content="打开数据目录" Click="OpenDataFolder" HorizontalAlignment="Left" Margin="0,0,0,28" />
          <Separator Background="#DFE3D9" Margin="0,0,0,24" />
          <TextBlock Text="备份与迁移" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
          <TextBlock Text="备份包含全部便签、分组、图片和回收站。导入同一张便签时创建副本，不覆盖现有内容。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,18" LineHeight="22" />
          <StackPanel Orientation="Horizontal">
            <Button Content="导出备份…" Click="ExportBackup" Style="{StaticResource PrimaryButton}" />
            <Button Content="导入备份…" Click="ImportBackup" />
          </StackPanel>
          <TextBlock x:Name="DataStatus" TextWrapping="Wrap" Foreground="#466451" Margin="0,18,0,0" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="应用">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
          <TextBlock Text="应用" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Sticky · 本地优先的桌面便签" Foreground="{StaticResource Muted}" Margin="0,8,0,28" />
          <Border Background="#EEF0E9" CornerRadius="8" Padding="18" Margin="0,0,0,26">
            <StackPanel><TextBlock Text="{Binding ApplicationVersion}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding StorageMode}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
          </Border>
          <TextBlock Text="便签与窗口" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
          <TextBlock Text="编辑内容会自动保存在本地。关闭管理窗口后，便签和托盘仍继续运行；可以从托盘重新打开管理页。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="23" Margin="0,0,0,18" />
          <Button Content="打开便签管理" Click="OpenManager" HorizontalAlignment="Left" Margin="0,0,0,28" />
          <Separator Background="#DFE3D9" Margin="0,0,0,24" />
          <TextBlock Text="退出应用" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
          <TextBlock Text="保存全部便签后，关闭所有窗口并退出托盘进程。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />
          <Button Content="退出 Sticky" Click="ExitApplication" HorizontalAlignment="Left" Foreground="#A34343" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
