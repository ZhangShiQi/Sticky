<Window x:Class="Sticky.App.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticky · 保险箱设置" Width="740" Height="260" MinWidth="640" MinHeight="220"
        Background="#F8F8F6" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="保险箱" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock x:Name="Status" Text="已锁定 · 输入主密码后查看" Foreground="#657064" Margin="0,8,0,12" TextWrapping="Wrap"/>
      <WrapPanel>
        <Button x:Name="UnlockButton" Content="解锁 / 创建" Click="UnlockClicked"/>
        <Button x:Name="RecoveryButton" Content="使用恢复密钥" Click="RecoveryClicked"/>
        <Button x:Name="LockButton" Content="立即锁定" Click="LockClicked"/>
        <Button x:Name="ExportButton" Content="导出加密保险箱…" Click="ExportClicked"/>
        <Button x:Name="ImportButton" Content="导入加密保险箱…" Click="ImportClicked"/>
        <Button x:Name="PasswordButton" Content="修改主密码…" Click="PasswordClicked"/>
      </WrapPanel>
    </StackPanel>
    <TextBlock Grid.Row="2" Text="私密内容仅在解锁时显示；闲置 5 分钟、系统锁屏或退出程序后锁定。保险箱不参与普通搜索、AI 或 Git 同步。" TextWrapping="Wrap" FontSize="12" Foreground="#657064"/>
  </Grid>
</Window>
