<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Sticky</AssemblyName>
    <RootNamespace>Sticky.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Sticky.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sticky.Capture\Sticky.Capture.csproj" />
    <ProjectReference Include="..\Sticky.UpdateEngine\Sticky.UpdateEngine.csproj" />
    <ProjectReference Include="..\Sticky.Core\Sticky.Core.csproj" />
    <ProjectReference Include="..\Sticky.Storage\Sticky.Storage.csproj" />
    <ProjectReference Include="..\Sticky.Sync.Git\Sticky.Sync.Git.csproj" />
  </ItemGroup>
  <ItemGroup><Compile Remove="Updates\UpdatePackage.cs" /><Compile Remove="SingleInstanceHost.cs" /></ItemGroup>
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\Sticky.ico" /><Resource Include="Assets\Sticky.svg" /><Resource Include="Assets\HistoryActions.svg" /><Resource Include="Assets\AiActions.svg" /></ItemGroup>
  <ItemGroup Condition="'$(StickyPortable)' == 'true'"><AssemblyMetadata Include="StickyPortable" Value="true" /></ItemGroup>
</Project>
