<Window x:Class="Sticky.App.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/Sticky;component/Assets/Sticky.ico"
        Title="便签 · Sticky" Width="390" Height="320" MinWidth="280" MinHeight="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        Closing="OnClosing" LocationChanged="LayoutChanged" SizeChanged="LayoutChanged"
        PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" AllowDrop="True" PreviewKeyDown="OnWindowKeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style x:Key="NoteButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#E8E8E8" />
      <Setter Property="Padding" Value="7,4" /><Setter Property="Margin" Value="0" /><Setter Property="MinWidth" Value="30" />
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource NoteButton}">
      <Setter Property="Foreground" Value="#372C40" /><Setter Property="Padding" Value="7,3" />
    </Style>
    <Style x:Key="FormatToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" /><Setter Property="Foreground" Value="#DEDEDE" />
      <Setter Property="Width" Value="31" /><Setter Property="Height" Value="30" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="ToggleSurface" CornerRadius="4" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#20FFFFFF" /></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#38FFFFFF" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="NoteSurface" CornerRadius="8" Background="#303030" BorderBrush="#555555" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border x:Name="HeaderBar" Background="#C18AFF" CornerRadius="7,7,0,0" MouseLeftButtonDown="DragHeader" ToolTip="拖动色条移动便签；点击正文开始编辑">
        <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="8" />
          <Style.Triggers><DataTrigger Binding="{Binding IsHeaderExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Height" Value="32" /></DataTrigger></Style.Triggers>
        </Style></Border.Style>
        <DockPanel Visibility="{Binding IsHeaderExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" LastChildFill="True">
          <Button DockPanel.Dock="Left" Content="＋" FontSize="22" Style="{StaticResource HeaderButton}" Click="NewNote" ToolTip="新建便签 · Ctrl+N" AutomationProperties.Name="新建便签" />
          <Button DockPanel.Dock="Right" Content="×" FontSize="22" Style="{StaticResource HeaderButton}" Click="CloseNote" ToolTip="关闭窗口，保留便签" AutomationProperties.Name="关闭便签" />
          <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="···" FontSize="18" Style="{StaticResource HeaderButton}" Click="OpenMenu" ToolTip="分组、颜色和更多操作" AutomationProperties.Name="便签菜单" />
          <Button x:Name="ColorButton" DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Click="OpenColorPalette" ToolTip="更改便签颜色" AutomationProperties.Name="便签颜色">
            <Border x:Name="ColorSwatch" Width="14" Height="14" CornerRadius="2" Background="#FFF1CA" BorderBrush="#80372C40" BorderThickness="1" />
          </Button>
          <Button x:Name="SaveIndicator" DockPanel.Dock="Right" Content="✓" Style="{StaticResource HeaderButton}" Click="ManualSave" ToolTip="{Binding Text, ElementName=SaveStatus}" AutomationProperties.Name="保存状态" />
          <TextBlock x:Name="HeaderTitle" FontSize="12" FontWeight="SemiBold" Foreground="#372C40" Margin="3,0,6,0" VerticalAlignment="Center"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="便签标题" />
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Margin="11,12,10,10">
        <RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Padding="0" FontSize="16" Foreground="#ECECEC" CaretBrush="#ECECEC"
                     VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" AcceptsTab="True" IsReadOnly="True"
                     PreviewMouseLeftButtonDown="StartEditing" SelectionChanged="EditorSelectionChanged" TextChanged="ContentChanged"
                     IsDocumentEnabled="True" IsInactiveSelectionHighlightEnabled="True" SpellCheck.IsEnabled="False" AutomationProperties.Name="便签正文" />
        <TextBlock x:Name="Placeholder" Text="点击这里，写下想法…" Foreground="#A5A5A5" Margin="3,2,0,0" IsHitTestVisible="False" />
      </Grid>
      <Border Grid.Row="2" x:Name="FormattingBar" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" Padding="7,3"
              Visibility="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Style="{StaticResource FormatToggle}" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" ToolTip="加粗 · Ctrl+B" />
          <ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" Style="{StaticResource FormatToggle}" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" ToolTip="斜体 · Ctrl+I" />
          <ToggleButton x:Name="UnderlineButton" Style="{StaticResource FormatToggle}" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" ToolTip="下划线 · Ctrl+U"><TextBlock Text="U" TextDecorations="Underline" /></ToggleButton>
          <ToggleButton x:Name="StrikeButton" Style="{StaticResource FormatToggle}" Click="ToggleStrike" ToolTip="删除线"><TextBlock Text="ab" TextDecorations="Strikethrough" /></ToggleButton>
          <Button Content="• ≡" Style="{StaticResource NoteButton}" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}" ToolTip="项目列表" />
          <Button Content="1 ≡" Style="{StaticResource NoteButton}" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}" ToolTip="编号列表" />
          <Button Content="▧" FontSize="21" Style="{StaticResource NoteButton}" Click="InsertImage" ToolTip="插入图片，也可粘贴截图或拖入图片" AutomationProperties.Name="插入图片" />
          <Button x:Name="AiButton" Content="AI" FontSize="12" Style="{StaticResource NoteButton}" Click="AiPolishClicked" ToolTip="选择 AI 功能，处理选中文字" AutomationProperties.Name="AI 功能菜单"/>
        </StackPanel>
      </Border>
      <!-- Metadata is edited through the menu and never consumes document space. -->
      <TextBox x:Name="TitleBox" Visibility="Collapsed" MaxLength="500" TextChanged="ContentChanged" />
      <TextBlock x:Name="SaveStatus" Visibility="Collapsed" Text="已保存在本地" />
      <TextBlock x:Name="WordCount" Visibility="Collapsed" />
    </Grid>
  </Border>
</Window>
