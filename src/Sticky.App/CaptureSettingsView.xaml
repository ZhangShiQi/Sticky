<UserControl x:Class="Sticky.App.CaptureSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,12">
      <TextBlock Text="截图与录制" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="截图、长图、标注、离线识别与 GIF / MP4 录制，均已内置。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
      <CheckBox x:Name="EnabledCheck" Content="启用截图全局快捷键" Margin="0,0,0,12"/>
      <WrapPanel Margin="0,0,0,12">
        <CheckBox x:Name="CtrlCheck" Content="Ctrl" Margin="0,0,14,0" VerticalAlignment="Center"/>
        <CheckBox x:Name="AltCheck" Content="Alt" Margin="0,0,14,0" VerticalAlignment="Center"/>
        <CheckBox x:Name="ShiftCheck" Content="Shift" Margin="0,0,14,0" VerticalAlignment="Center"/>
        <ComboBox x:Name="KeyChoice" Width="80" AutomationProperties.Name="截图快捷键字母"/>
      </WrapPanel>
      <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Foreground="#466451" Margin="0,0,0,12"/>
      <Button Content="开始截图" Click="StartCapture" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
      <TextBlock Text="框选后可标注、二维码识别、OCR（Ctrl+T）、AI 看图（Ctrl+I）、长截图（Ctrl+L）或区域录制。Enter 复制，Ctrl+S 保存，Esc 取消。" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,20"/>
      <Separator Margin="0,0,0,18"/>
      <TextBlock Text="录制默认值" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <WrapPanel Margin="0,0,0,12"><TextBlock Text="帧率" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="FpsChoice" Width="100" AutomationProperties.Name="录制默认帧率"/></WrapPanel>
      <CheckBox x:Name="CursorCheck" Content="录制鼠标指针" Margin="0,0,0,10"/>
      <CheckBox x:Name="CountdownCheck" Content="开始前倒计时 3 秒" Margin="0,0,0,12"/>
      <TextBlock Text="单显示器固定区域，最长 60 秒，无声音；停止后可预览、裁剪和导出 GIF / MP4。F8 停止，占用时尝试 Ctrl+Alt+F8。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="22" Margin="0,0,0,20"/>
      <TextBlock Text="截图文字 AI 的连接" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <CheckBox x:Name="ReuseAiCheck" Content="复用便签 AI 连接" Margin="0,0,0,10"/>
      <ComboBox x:Name="AiConnectionChoice" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="截图复用的便签 AI 连接" Margin="0,0,0,10"/>
      <TextBlock Text="关闭时使用「AI 接入 → 截图文字 AI」的独立配置；开启时使用上方选择的连接。视觉 AI 可继续独立配置或沿用文字 AI 的地址与密钥。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="22" Margin="0,0,0,18"/>
      <Button Content="保存并应用" Click="SavePreferences" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,20"/>
      <Separator Margin="0,0,0,18"/>
      <TextBlock Text="本地组件与缓存" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock x:Name="ComponentStatus" TextWrapping="Wrap" LineHeight="22"/>
      <TextBlock Text="长截图与录制缓存位于系统临时目录，不进入便签同步。录制缓存最多 1 GiB，正常关闭清理；启动后清理本模块无活动会话的遗留录制缓存。自启动和版本更新由 Sticky 的对应设置统一管理。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="22" Margin="0,10,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
