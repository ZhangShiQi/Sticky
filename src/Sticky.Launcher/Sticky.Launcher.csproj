<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>..\Sticky.App\Assets\Sticky.ico</ApplicationIcon>
    <ApplicationManifest>..\Sticky.App\app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\Sticky.UpdateEngine\Sticky.UpdateEngine.csproj" /></ItemGroup>
</Project>
